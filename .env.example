# Copy to .env (docker-compose) or export (bare binary).
RK_BIND=0.0.0.0:8787
# Upload accounts: name:token pairs, comma-separated.
RK_TOKENS=saintbellarmine:change-me-please
# Discord channel webhook for result announcements (empty = disabled).
RK_WEBHOOK_URL=
# Whether match lists are readable without a token.
RK_PUBLIC_READ=1
# Public URL of this server, used in Discord announcements and links.
RK_BASE_URL=http://localhost:8787
# Where replays + the database live (bare binary only; the container mounts ./data).
RK_DATA_DIR=./data
